rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to validate member data
    function isValidMember() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'fatherName', 'joiningDate', 'monthlyFee', 'status']) &&
             data.name is string && data.name.size() > 0 &&
             data.fatherName is string && data.fatherName.size() > 0 &&
             data.monthlyFee is number && data.monthlyFee > 0 &&
             data.status in ['paid', 'unpaid'];
    }
    
    // Members collection - Only authenticated users can access
    match /members/{memberId} {
      // Allow read if authenticated
      allow read: if isAuthenticated();
      
      // Allow create if authenticated and data is valid
      allow create: if isAuthenticated() && isValidMember();
      
      // Allow update if authenticated and data is valid
      allow update: if isAuthenticated() && isValidMember();
      
      // Allow delete if authenticated
      allow delete: if isAuthenticated();
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

